# Never commit a real API key. Inject it at runtime only. Leave AZURE_OPENAI_API_KEY
# blank to run the default offline, deterministic 'fixture' provider (no key, no
# network, no spend) — that path is what makes the artifact reproducible without
# credentials, so it stays the default.
AZURE_OPENAI_API_KEY=
# The resource host, NOT an AI Foundry project URL. A .../api/projects/<name>
# endpoint is the project resource and returns 404 to an inference POST; the
# provider rejects it with a clear message rather than failing at first call.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Set to 'azure' for live model calls; 'fixture' (the default) runs offline.
TRACEGUARD_PROVIDER=

# Crew deployments, per agent role. These are Azure DEPLOYMENT names, not base
# model names — the two are independent on Azure, and it is the deployment name
# that is recorded in every run's provenance.
MODEL_FAST=gpt-4o
MODEL_DEEP=gpt-4o
MODEL_REVIEW=gpt-4o
MODEL_VISION=gpt-4o

# The independent utility judge is passed to scripts/judge_utility.py separately
# (--judge-model) and is never part of the crew; the script refuses to run if the
# judge deployment is also a crew deployment.

# Soft per-run token guardrail. The vision model is recorded for provenance but
# is not used by this text-only clinical-writing experiment.
MAX_TOKENS_PER_MATTER=400000

# Public TraceShield profile for the reference runtime. The step deadline MUST be
# calibrated against the deployment's measured latency, not inherited: on the
# gpt-5.6 deployments the measured p50 is 3.0 s and p99 8.7 s, so the previous
# 3000 ms value would fail closed on 48.3% of steps and the defense would be
# unusable. 10000 ms gives 0% fail-closed with headroom over p99. The 250 ms
# value below is fixture-only.
TRACEGUARD_CANONICAL_HOPS=7
TRACEGUARD_STEP_DEADLINE_MS=250   # fixture only; see the note above
TRACEGUARD_STEP_EGRESS_BYTES=4096
TRACEGUARD_RECEIPT_ENVELOPE_BYTES=8192
TRACEGUARD_ARTIFACT_DIR=/data
TRACEGUARD_SIGNING_KEY_FILE=/data/runtime/signing-key.pem

# Server settings.
TRACEGUARD_HOST=0.0.0.0
TRACEGUARD_PORT=8080
TRACEGUARD_LOG_LEVEL=INFO

# Deployment isolation label, reported verbatim by GET /api/runtime (honest
# self-report only — never used to assert a hardware TEE). Set by the confidential
# -container deploy, e.g. "kata-qemu". Leave unset for a plain local container.
TRACEGUARD_ISOLATION=
