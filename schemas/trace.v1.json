{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/traceguard/schemas/trace.v1.json",
  "title": "TraceGuard host-observable trace",
  "description": "Application-boundary metadata only. Payload, labels, query, documents, result cardinality, prompts, and answers are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "steps"],
  "properties": {
    "schema_version": {"const": "trace.v1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "step_type", "duration_ms", "egress_bytes"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "step_type": {
            "type": "string",
            "enum": ["orchestrator", "research", "draft", "citation", "review", "editor"]
          },
          "duration_ms": {"type": "number", "minimum": 0},
          "egress_bytes": {"type": "integer", "minimum": 0},
          "overrun": {"type": "boolean"}
        }
      }
    }
  }
}

