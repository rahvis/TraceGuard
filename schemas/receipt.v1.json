{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/traceguard/schemas/receipt.v1.json",
  "title": "TraceGuard Trace Receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "receipt_id",
    "run_id",
    "provenance",
    "scope",
    "condition",
    "guarantee",
    "mechanisms",
    "dataset_hash",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "receipt.v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "string",
      "enum": ["synthetic_fixture", "live_replication"]
    },
    "scope": {"const": "control-flow"},
    "condition": {
      "type": "string",
      "enum": ["adaptive", "structure_only", "full_pad"]
    },
    "guarantee": {
      "type": "object",
      "required": ["kind", "certified"],
      "properties": {
        "kind": {"type": "string"},
        "epsilon": {"type": ["number", "null"]},
        "delta": {"type": ["number", "null"]},
        "certified": {"type": "boolean"},
        "boundary": {"type": "string"}
      }
    },
    "mechanisms": {"type": "array", "items": {"type": "string"}},
    "dataset_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger": {
      "type": "object",
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "previous_hash": {"type": "string"}
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "public_key", "value"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "public_key": {"type": "string"},
        "value": {"type": "string"}
      }
    }
  }
}

