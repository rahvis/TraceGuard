# TraceGuard Azure Confidential VM deployment parameters.
# Copy to deploy.env and fill in. No secrets are committed; deploy.env is git-ignored.

# --- Azure identity (optional if `az login` already targets the right sub) ---
SUBSCRIPTION_ID=
TENANT_ID=

# --- Placement ---------------------------------------------------------------
RESOURCE_GROUP=traceguard-cc
# Regions with AMD SEV-SNP DCasv5: eastus2, westeurope, northeurope, eastus, ...
# Verify:  az vm list-skus --location eastus2 --query "[?family=='standardDCASv5Family'].name" -o tsv
LOCATION=eastus2
NAME_PREFIX=traceguard

# --- Confidential VM sizing --------------------------------------------------
# AMD SEV-SNP families: Standard_DC{2,4,8,16,...}as_v5 (or DCadsv5 with a temp disk).
# For Intel TDX instead, use a DCesv5 size and set OSDISK_ENC_TYPE accordingly.
VM_SIZE=Standard_DC4as_v5
OSDISK_ENC_TYPE=VMGuestStateOnly

# --- OS image (Canonical Ubuntu CVM) -----------------------------------------
IMAGE_OFFER=ubuntu-24_04-lts
IMAGE_SKU=cvm

# --- Access ------------------------------------------------------------------
ADMIN_USERNAME=azureuser
SSH_PUBLIC_KEY_FILE=~/.ssh/id_rsa.pub
# Lock these to your IP (e.g. 203.0.113.5/32) for anything beyond a short demo.
SSH_SOURCE_CIDR=*
APP_SOURCE_CIDR=*

# --- Bootstrap mode ------------------------------------------------------------
# build = classic demo: the VM clones REPO_URL and docker-builds on first boot.
# ghcr  = CI/CD host prep only: the VM gets Docker + tpm2-tools and directories;
#         GitHub Actions delivers the app from GHCR on every push (REPO_URL and
#         the ANTHROPIC embed options below are unused). Recommended with a
#         dedicated deploy keypair, e.g. SSH_PUBLIC_KEY_FILE=~/.ssh/traceguard_deploy.pub.
BOOTSTRAP_MODE=build

# --- Source the VM will build (build mode only) --------------------------------
# A git URL the VM can clone. For a private repo, use a deploy-token URL, or use
# the Azure Container Registry alternative described in README.md.
REPO_URL=
REPO_BRANCH=main

# --- Microsoft Azure Attestation provider ------------------------------------
# A regional shared MAA provider (default policy). Match the region for latency.
MAA_ENDPOINT=https://sharedeus2.eus2.attest.azure.net

# --- Provider credentials are NOT set here -----------------------------------
# No provider secret is embedded in VM custom-data. GitHub Actions streams the
# runtime environment over SSH at deploy time, so the key is never visible in an
# Azure field. Set AZURE_OPENAI_API_KEY / AZURE_OPENAI_ENDPOINT as repository
# secrets instead; leaving them unset runs the offline fixture provider, which is
# still a fully attested demo.
